# Copie para .env e preencha
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Termo de busca na Gupy (sem espaços ou use %20)
SEARCH_TERM=Suporte

# remote | hybrid | on-site
WORKPLACE=remote

# Termos que o título DEVE conter (separados por vírgula). Deixe vazio para não filtrar.
REQUIRED_TERMS=

# Termos que descartam a vaga (separados por vírgula). Deixe vazio para não descartar.
EXCLUDED_TERMS=

# Máximo de alertas por execução
MAX_ALERTS=10
